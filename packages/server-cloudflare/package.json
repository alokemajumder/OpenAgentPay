{
  "name": "@openagentpay/server-cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare Workers paywall middleware for OpenAgentPay — deploy payment-gated APIs at the edge",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "openagentpay",
    "cloudflare",
    "workers",
    "edge",
    "payment-gating",
    "ai-agents",
    "payments",
    "paywall",
    "402",
    "x402"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@openagentpay/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
